datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id                Int                @id @default(autoincrement())
  login             String             @unique @db.VarChar(100)
  password          String             @db.VarChar(255)
  name              String?            @db.VarChar(255)
  email             String?            @unique @db.VarChar(255)
  token_version     Int                @default(0)
  created_at        DateTime           @default(now())
  user_transactions UserTransactions[]
  refresh_tokens    RefreshToken[]

  @@map("users")
}

model Transactions {
  id                Int                @id @default(autoincrement())
  hash              String             @unique @default(uuid())
  name              String             @db.VarChar(199)
  amount            Decimal            @db.Decimal(10, 2)
  created_at        DateTime           @default(now())
  created_by        Int?
  deleted_at        DateTime?
  deleted_by        Int?
  user_transactions UserTransactions[]

  @@map("transactions")
}

model UserTransactions {
  id             Int          @id @default(autoincrement())
  user_id        Int
  transaction_id Int
  created_at     DateTime     @default(now())
  user           User         @relation(fields: [user_id], references: [id])
  transaction    Transactions @relation(fields: [transaction_id], references: [id])

  @@map("user_transactions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  lookupKey String?   @map("lookup_key")
  userId    Int       @map("user_id")
  family    String
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId], map: "refresh_tokens_user_id_fkey")
  @@index([family], map: "refresh_tokens_family_idx")
  @@index([lookupKey], map: "refresh_tokens_lookup_key_idx")
  @@map("refresh_tokens")
}
